# Keep only the delivery documents in Git
/docs/*
!/docs/candidate_task.md
!/docs/DESIGN.md
!/docs/EXPERIMENTS.md

# Common compiler artifacts
*.obj
*.pdb
*.ilk
*.exe
*.lib
*.exp

# OS/editor noise
.DS_Store
Thumbs.db
*.user
*.suo
